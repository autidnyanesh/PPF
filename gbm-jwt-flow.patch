@@ -0,0 +1,84 @@
+package com.idbi.gbm.security;
+
+import com.idbi.gbm.entity.GbmUser;
+import io.jsonwebtoken.Claims;
+import io.jsonwebtoken.Jwts;
+import io.jsonwebtoken.security.Keys;
+import java.nio.charset.StandardCharsets;
+import java.time.Instant;
+import java.util.Date;
+import java.util.UUID;
+import javax.crypto.SecretKey;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.stereotype.Service;
+
+@Service
+public class JwtService {
+    public static final String TOKEN_TYPE = "Bearer";
+
+    private final SecretKey key;
+    private final long ttlMinutes;
+    private final TokenDenylist denylist;
+
+    public JwtService(
+            @Value("${gbm.jwt.secret}") String secret,
+            @Value("${gbm.jwt.ttl-minutes:30}") long ttlMinutes,
+            TokenDenylist denylist) {
+        byte[] bytes = secret.getBytes(StandardCharsets.UTF_8);
+        if (bytes.length < 32) {
+            throw new IllegalStateException("gbm.jwt.secret must be at least 32 bytes");
+        }
+        this.key = Keys.hmacShaKeyFor(bytes);
+        this.ttlMinutes = ttlMinutes;
+        this.denylist = denylist;
+    }
+
+    public Instant expiresAt() {
+        return Instant.now().plusSeconds(ttlMinutes * 60);
+    }
+
+    public String createToken(GbmUser user) {
+        Instant now = Instant.now();
+        Instant exp = now.plusSeconds(ttlMinutes * 60);
+        return Jwts.builder()
+                .id(UUID.randomUUID().toString())
+                .subject(user.getUsername())
+                .claim("uid", user.getId())
+                .claim("role", user.getRole().name())
+                .claim("displayName", user.getDisplayName())
+                .issuedAt(Date.from(now))
+                .expiration(Date.from(exp))
+                .signWith(key)
+                .compact();
+    }
+
+    public Claims parse(String token) {
+        Claims claims = Jwts.parser().verifyWith(key).build().parseSignedClaims(token).getPayload();
+        if (denylist.isRevoked(claims.getId())) {
+            throw new IllegalArgumentException("Token has been revoked");
+        }
+        return claims;
+    }
+
+    public void revoke(String authorizationHeader) {
+        String token = extractBearer(authorizationHeader);
+        if (token == null) {
+            return;
+        }
+        Claims claims = Jwts.parser().verifyWith(key).build().parseSignedClaims(token).getPayload();
+        Date expiration = claims.getExpiration();
+        denylist.revoke(claims.getId(), expiration == null ? expiresAt() : expiration.toInstant());
+    }
+
+    public static String extractBearer(String authorizationHeader) {
+        if (authorizationHeader == null) {
+            return null;
+        }
+        String value = authorizationHeader.trim();
+        if (value.length() < 8 || !value.regionMatches(true, 0, "Bearer ", 0, 7)) {
+            return null;
+        }
+        String token = value.substring(7).trim();
+        return token.isEmpty() ? null : token;
+    }
+}
