+    header { background:var(--navy); color:#fff; padding:10px 16px; display:flex; gap:16px; align-items:center; }
+    header strong { font-size:18px; }
+    nav { background:var(--bar); padding:8px 12px; display:flex; gap:8px; }
+    nav button, .btn { border:0; background:#2b6ea3; color:#fff; padding:8px 12px; cursor:pointer; }
+    nav button.active, .btn.primary { background:#f0f4f8; color:var(--navy); font-weight:bold; }
+    main { padding:20px; max-width:980px; margin:0 auto; }
+    .card { background:#fff; border:1px solid var(--line); padding:20px; margin-bottom:16px; }
+    label { display:block; font-size:13px; color:#445; margin:8px 0 4px; }
+    input, select { width:100%; padding:8px; border:1px solid var(--line); }
+    table { width:100%; border-collapse:collapse; }
+    th, td { border-bottom:1px solid var(--line); text-align:left; padding:8px; font-size:14px; }
+    .error { color:#a40000; margin-top:8px; }
+    .hidden { display:none; }
+    .row { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
+  </style>
+</head>
+<body>
+  <header>
+    <strong>GBM</strong>
+    <span>Government Business Module</span>
+    <span id="userLabel"></span>
+  </header>
+  <nav id="moduleNav" class="hidden">
+    <button data-module="home" class="active">Home</button>
+    <button data-module="ppf">PPF</button>
+    <button id="logoutBtn">Logout</button>
+  </nav>
+  <main>
+    <section id="loginView" class="card">
+      <h2>GBM Login</h2>
+      <p>Sign in to the platform. PPF opens only after login, from GBM Home.</p>
+      <label>Username</label>
+      <input id="username" value="admin.ppf" />
+      <label>Password</label>
+      <input id="password" type="password" value="Admin@123456" />
+      <p><button class="btn primary" id="loginBtn">Login</button></p>
+      <div class="error" id="loginError"></div>
+    </section>
+
+    <section id="homeView" class="card hidden">
+      <h2>Welcome To GBM</h2>
+      <p id="homeMessage"></p>
+      <p>Choose a scheme module. Authentication stays in GBM; PPF only verifies the token.</p>
+      <p><button class="btn primary" data-open="ppf">Open PPF module</button></p>
+    </section>
+
+    <section id="ppfView" class="card hidden">
+      <h2>Public Provident Fund</h2>
+      <p id="ppfHome"></p>
+      <h3>Open account</h3>
+      <div class="row">
+        <div><label>Account number</label><input id="accNo" value="PPF24001852" /></div>
+        <div><label>Customer name</label><input id="custName" value="Ananya Rao" /></div>
+      </div>
+      <div class="row">
+        <div><label>Customer id</label><input id="custId" value="CUST1001" /></div>
+        <div><label>Opening balance</label><input id="openBal" value="5000" /></div>
+      </div>
+      <p><button class="btn primary" id="openAccBtn">Create account</button></p>
+      <div class="error" id="ppfError"></div>
+      <h3>Accounts</h3>
+      <table>
+        <thead><tr><th>Number</th><th>Customer</th><th>Balance</th><th>Status</th></tr></thead>
+        <tbody id="accRows"></tbody>
+      </table>
+    </section>
+  </main>
+  <script>
+    const GBM = "";
+    const state = { token: localStorage.getItem("gbmToken"), home: null };
+
+    const $ = (id) => document.getElementById(id);
+    const show = (id) => {
+      ["loginView", "homeView", "ppfView"].forEach((v) => $(v).classList.toggle("hidden", v !== id));
+    };
+
+    async function api(url, options = {}) {
+      const headers = Object.assign({ "Content-Type": "application/json" }, options.headers || {});
+      if (state.token) headers.Authorization = "Bearer " + state.token;
+      const res = await fetch(url, Object.assign({}, options, { headers }));
+      const text = await res.text();
+      const body = text ? JSON.parse(text) : {};
+      if (!res.ok) throw new Error(body.message || res.statusText);
+      return body;
+    }
+
+    async function afterLogin() {
+      state.home = await api(GBM + "/api/home");
+      $("userLabel").textContent = "User: " + state.home.user.username;
+      $("homeMessage").textContent = state.home.message + " — signed in as " + state.home.user.displayName;
+      $("moduleNav").classList.remove("hidden");
+      show("homeView");
+    }
+
+    $("loginBtn").onclick = async () => {
+      $("loginError").textContent = "";
+      try {
+        const res = await api(GBM + "/api/auth/login", {
+          method: "POST",
+          body: JSON.stringify({ username: $("username").value, password: $("password").value })
+        });
+        state.token = res.token;
+        localStorage.setItem("gbmToken", res.token);
+        await afterLogin();
+      } catch (e) { $("loginError").textContent = e.message; }
+    };
+
+    $("logoutBtn").onclick = async () => {
+      try { await api(GBM + "/api/auth/logout", { method: "POST" }); } catch (e) {}
+      state.token = null;
+      localStorage.removeItem("gbmToken");
+      $("moduleNav").classList.add("hidden");
+      $("userLabel").textContent = "";
+      show("loginView");
+    };
+
+    async function openPpf() {
+      $("ppfError").textContent = "";
+      const ppf = state.home.modules.find((m) => m.code === "PPF");
+      try {
+        const home = await api(ppf.baseUrl + ppf.homePath);
+        $("ppfHome").textContent = home.title + " — " + home.username;
+        const accounts = await api(ppf.baseUrl + ppf.accountsPath);
+        $("accRows").innerHTML = accounts.map((a) =>
+          `<tr><td>${a.accountNumber}</td><td>${a.customerName}</td><td>${a.balance}</td><td>${a.status}</td></tr>`
+        ).join("") || "<tr><td colspan='4'>No accounts yet</td></tr>";
+        document.querySelectorAll("nav button").forEach((b) => b.classList.toggle("active", b.dataset.module === "ppf"));
+        show("ppfView");
+      } catch (e) { $("ppfError").textContent = e.message; show("ppfView"); }
+    }
+
+    $("openAccBtn").onclick = async () => {
+      const ppf = state.home.modules.find((m) => m.code === "PPF");
+      $("ppfError").textContent = "";
+      try {
+        await api(ppf.baseUrl + ppf.accountsPath, {
+          method: "POST",
+          body: JSON.stringify({
+            accountNumber: $("accNo").value,
+            customerName: $("custName").value,
+            customerId: $("custId").value,
+            openingBalance: Number($("openBal").value),
+            openedOn: new Date().toISOString().slice(0, 10)
+          })
+        });
+        await openPpf();
+      } catch (e) { $("ppfError").textContent = e.message; }
+    };
+
+    document.querySelectorAll("[data-module], [data-open]").forEach((el) => {
+      el.onclick = () => {
+        const target = el.dataset.module || el.dataset.open;
+        if (target === "home") { document.querySelectorAll("nav button").forEach((b) => b.classList.toggle("active", b.dataset.module === "home")); show("homeView"); }
+        if (target === "ppf") openPpf();
+      };
+    });
+
+    if (state.token) afterLogin().catch(() => { localStorage.removeItem("gbmToken"); show("loginView"); });
+  </script>
+</body>
+</html>
diff --git a/src/test/java/com/idbi/gbm/AuthFlowTest.java b/src/test/java/com/idbi/gbm/AuthFlowTest.java
new file mode 100644
index 0000000..02b73a8
--- /dev/null
+++ b/src/test/java/com/idbi/gbm/AuthFlowTest.java
@@ -0,0 +1,63 @@
+package com.idbi.gbm;
+
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.http.MediaType;
+import org.springframework.test.context.ActiveProfiles;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.MvcResult;
+
+@SpringBootTest
+@AutoConfigureMockMvc
+@ActiveProfiles("test")
+class AuthFlowTest {
+    @Autowired
+    private MockMvc mockMvc;
+
+    @Test
+    void loginIssuesJwtThenHomeRequiresIt() throws Exception {
+        mockMvc.perform(post("/api/auth/bootstrap")
+                        .contentType(MediaType.APPLICATION_JSON)
+                        .content("""
+                                {"username":"admin.ppf","password":"Admin@123456","displayName":"GBM Admin"}
+                                """))
+                .andExpect(status().isOk())
+                .andExpect(jsonPath("$.username").value("admin.ppf"));
+
+        mockMvc.perform(get("/api/home")).andExpect(status().isUnauthorized());
+
+        MvcResult login = mockMvc.perform(post("/api/auth/login")
+                        .contentType(MediaType.APPLICATION_JSON)
+                        .content("""
+                                {"username":"admin.ppf","password":"Admin@123456"}
+                                """))
+                .andExpect(status().isOk())
+                .andExpect(jsonPath("$.token").isNotEmpty())
+                .andExpect(jsonPath("$.tokenType").value("Bearer"))
+                .andExpect(jsonPath("$.user.username").value("admin.ppf"))
+                .andReturn();
+
+        String token = com.fasterxml.jackson.databind.json.JsonMapper.builder().build()
+                .readTree(login.getResponse().getContentAsString())
+                .get("token")
+                .asText();
+
+        mockMvc.perform(get("/api/home").header("Authorization", "Bearer " + token))
+                .andExpect(status().isOk())
+                .andExpect(jsonPath("$.message").value("Welcome To GBM"))
+                .andExpect(jsonPath("$.modules[0].code").value("PPF"));
+
+        mockMvc.perform(post("/api/auth/logout").header("Authorization", "Bearer " + token))
+                .andExpect(status().isOk());
+
+        mockMvc.perform(get("/api/home").header("Authorization", "Bearer " + token))
+                .andExpect(status().isUnauthorized());
+    }
+}
