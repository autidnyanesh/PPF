+package com.idbi.gbm.config;
+
+import com.idbi.gbm.entity.GbmUser;
+import com.idbi.gbm.entity.UserRole;
+import com.idbi.gbm.repository.GbmUserRepository;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.boot.ApplicationArguments;
+import org.springframework.boot.ApplicationRunner;
+import org.springframework.boot.autoconfigure.condition.ConditionalOnProperty;
+import org.springframework.security.crypto.password.PasswordEncoder;
+import org.springframework.stereotype.Component;
+
+@Component
+@ConditionalOnProperty(name = "gbm.seed-demo-admin", havingValue = "true")
+public class DemoUserLoader implements ApplicationRunner {
+    private static final Logger log = LoggerFactory.getLogger(DemoUserLoader.class);
+    private final GbmUserRepository users;
+    private final PasswordEncoder passwordEncoder;
+
+    public DemoUserLoader(GbmUserRepository users, PasswordEncoder passwordEncoder) {
+        this.users = users;
+        this.passwordEncoder = passwordEncoder;
+    }
+
+    @Override
+    public void run(ApplicationArguments args) {
+        if (users.count() > 0) {
+            return;
+        }
+        users.save(new GbmUser("admin.ppf", passwordEncoder.encode("Admin@123456"), "GBM Admin", UserRole.ADMIN));
+        log.info("Seeded demo admin username=admin.ppf password=Admin@123456");
+    }
+}
